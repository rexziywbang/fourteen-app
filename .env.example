# Public app configuration
NEXT_PUBLIC_APP_NAME=Fourteen
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com

# Local development adapter (never commit the resulting .data directory)
LOCAL_DB_PATH=.data/fourteen.sqlite
OTP_PEPPER=replace-with-a-long-random-value
ADMIN_ACCESS_KEY=replace-with-a-long-unique-founder-key
SEED_DEMO_USERS=true

# Hosted production foundation (wire before public deployment)
DATA_BACKEND=supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=Fourteen <sign-in@example.com>
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=
NOTIFICATION_EDGE_SECRET=
ADMIN_EMAILS=

# Dedicated staging project only; used by pnpm test:postgres
SUPABASE_TEST_URL=
SUPABASE_TEST_ANON_KEY=
SUPABASE_TEST_SERVICE_ROLE_KEY=
